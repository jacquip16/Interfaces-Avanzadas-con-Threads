<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="12.0" 
      xmlns="http://javafx.com/javafx/8.0.171" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.pilli.fabulas.PrimaryController">
   <children>
      <Label text="Fábulas gráficas de Esopo" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
      <Label text="La Liebre y la Tortuga" style="-fx-font-size: 13px;" />
      
      <Button fx:id="btnIniciar" text="¡Iniciar Carrera!" onAction="#btnIniciar_click" prefWidth="130.0" />

      <!-- Sección de la Liebre -->
      <Label fx:id="lblEstadoLiebre" text="La Liebre: En la línea de salida" />
      <ProgressBar fx:id="pgLiebre" progress="0.0" prefWidth="300.0" />

      <!-- Sección de la Tortuga -->
      <Label fx:id="lblEstadoTortuga" text="La Tortuga: En la línea de salida" />
      <ProgressBar fx:id="pgTortuga" progress="0.0" prefWidth="300.0" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>