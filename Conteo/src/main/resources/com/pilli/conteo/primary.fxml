<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="15.0" 
      xmlns="http://javafx.com/javafx/8.0.171" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.pilli.conteo.PrimaryController">
   <children>
     
      <Label text="Contar número de clics" />
      <TextField fx:id="txtClics" editable="false" text="0" alignment="CENTER" prefWidth="280.0" maxWidth="280.0" />
      <Button fx:id="btnContar" text="¡Contar!" onAction="#btnContar_click" prefWidth="100.0" />

      <!-- Espaciador -->
      <VBox prefHeight="10.0" />

      
      <Label text="Esperar 10 segundos" />
      <ProgressBar fx:id="pgBar" progress="0.0" prefWidth="280.0" />
      <Button fx:id="btnEsperar" text="¡Esperar!" onAction="#btnEsperar_click" prefWidth="100.0" />
   </children>
   <padding>
      <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
   </padding>
</VBox>